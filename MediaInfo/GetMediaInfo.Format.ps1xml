<?xml version="1.0" encoding="utf-8"?>
<Configuration>

<SelectionSets>
  <SelectionSet>
    <Name>GetMediaInfo.MediaInfoResultTypes</Name>
    <Types>
      <TypeName>GetMediaInfo.VideoMediaInfoResult</TypeName>
      <TypeName>GetMediaInfo.AudioMediaInfoResult</TypeName>
      <TypeName>GetMediaInfo.ImageMediaInfoResult</TypeName>
      <TypeName>GetMediaInfo.UnknownMediaInfoResult</TypeName>
    </Types>
  </SelectionSet>

  <SelectionSet>
  <Name>GetMediaInfo.MediaInfoResult.Extended.Types</Name>
  <Types>
    <TypeName>GetMediaInfo.VideoMediaInfoResult.Extended</TypeName>
    <TypeName>GetMediaInfo.AudioMediaInfoResult.Extended</TypeName>
    <TypeName>GetMediaInfo.ImageMediaInfoResult.Extended</TypeName>
    <TypeName>GetMediaInfo.UnknownMediaInfoResult.Extended</TypeName>
  </Types>
</SelectionSet>
</SelectionSets>

  <ViewDefinitions>

<View>
  <Name>GetMediaInfo.MediaInfoResult.List</Name>

  <ViewSelectedBy>
    <SelectionSetName>GetMediaInfo.MediaInfoResultTypes</SelectionSetName>
  </ViewSelectedBy>

  <ListControl>
    <ListEntries>

      <!-- Video -->
      <ListEntry>
        <EntrySelectedBy>
          <TypeName>GetMediaInfo.VideoMediaInfoResult</TypeName>
        </EntrySelectedBy>

        <ListItems>
          <ListItem>
            <Label>Name</Label>
            <PropertyName>Name</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Frame rate</Label>
            <ScriptBlock>
              if ($null -ne $_.FrameRate) {
                '{0:0.###} fps' -f $_.FrameRate
              }
            </ScriptBlock>
          </ListItem>

          <ListItem>
            <Label>Resolution</Label>
            <PropertyName>Resolution</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Duration</Label>
            <ScriptBlock>
              if ($null -ne $_.Duration) {
                $_.Duration.ToString('hh\:mm\:ss\.fff')
              }
            </ScriptBlock>
          </ListItem>

          <ListItem>
            <Label>Video</Label>
            <PropertyName>VideoCodec</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Audio</Label>
            <PropertyName>AudioCodec</PropertyName>
          </ListItem>
        </ListItems>
      </ListEntry>


      <!-- Audio -->
      <ListEntry>
        <EntrySelectedBy>
          <TypeName>GetMediaInfo.AudioMediaInfoResult</TypeName>
        </EntrySelectedBy>

        <ListItems>
          <ListItem>
            <Label>Name</Label>
            <PropertyName>Name</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Format</Label>
            <PropertyName>ContainerFormat</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Duration</Label>
            <ScriptBlock>
              if ($null -ne $_.Duration) {
                $_.Duration.ToString('hh\:mm\:ss\.fff')
              }
            </ScriptBlock>
          </ListItem>

          <ListItem>
            <Label>Audio</Label>
            <PropertyName>AudioCodec</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Artist</Label>
            <PropertyName>Artist</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Album</Label>
            <PropertyName>Album</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Track</Label>
            <ScriptBlock>
              if ($null -ne $_.TrackNumber) {
                if ($null -ne $_.TrackCount) {
                  '{0}/{1}' -f $_.TrackNumber, $_.TrackCount
                } else {
                  $_.TrackNumber
                }
              }
            </ScriptBlock>
          </ListItem>
        </ListItems>
      </ListEntry>


      <!-- Image -->
      <ListEntry>
        <EntrySelectedBy>
          <TypeName>GetMediaInfo.ImageMediaInfoResult</TypeName>
        </EntrySelectedBy>

        <ListItems>
          <ListItem>
            <Label>Name</Label>
            <PropertyName>Name</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Format</Label>
            <PropertyName>ImageFormat</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Resolution</Label>
            <PropertyName>Resolution</PropertyName>
          </ListItem>

          <ListItem>
            <Label>BitDepth</Label>
            <PropertyName>BitDepth</PropertyName>
          </ListItem>

          <ListItem>
            <Label>SizeMiB</Label>
            <ScriptBlock>
  if ($null -ne $_.SizeMiB) {
    '{0:F3}' -f $_.SizeMiB
  }
</ScriptBlock>
          </ListItem>
        </ListItems>
      </ListEntry>


      <!-- Unknown / default fallback -->
      <ListEntry>
        <ListItems>
          <ListItem>
            <Label>Name</Label>
            <PropertyName>Name</PropertyName>
          </ListItem>

          <ListItem>
            <Label>Format</Label>
            <PropertyName>ContainerFormat</PropertyName>
          </ListItem>

          <ListItem>
            <Label>SizeMiB</Label>
            <ScriptBlock>
  if ($null -ne $_.SizeMiB) {
    '{0:F3}' -f $_.SizeMiB
  }
</ScriptBlock>
          </ListItem>
        </ListItems>
      </ListEntry>

    </ListEntries>
  </ListControl>
</View>

