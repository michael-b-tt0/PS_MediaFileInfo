<View>
  <Name>GetMediaInfo.MediaInfoResult.Table</Name>

  <ViewSelectedBy>
    <SelectionSetName>GetMediaInfo.MediaInfoResultTypes</SelectionSetName>
  </ViewSelectedBy>

  <TableControl>

    <TableHeaders>
      <TableColumnHeader><Label>Name</Label><Width>45</Width></TableColumnHeader>
      <TableColumnHeader><Label>Type</Label></TableColumnHeader>
      <TableColumnHeader><Label>Format</Label></TableColumnHeader>
      <TableColumnHeader><Label>Details</Label></TableColumnHeader>
      <TableColumnHeader><Label>Duration</Label></TableColumnHeader>
      <TableColumnHeader><Label>Codec</Label></TableColumnHeader>
      <TableColumnHeader><Label>SizeMiB</Label></TableColumnHeader>
    </TableHeaders>

    <TableRowEntries>

  <TableRowEntry>
    <TableColumnItems>

      <!-- Name -->
      <TableColumnItem>
        <PropertyName>Name</PropertyName>
      </TableColumnItem>


      <!-- Type -->
      <TableColumnItem>
        <PropertyName>MediaType</PropertyName>
      </TableColumnItem>


      <!-- Format -->
      <TableColumnItem>
        <ScriptBlock>
          if ($_.MediaType -eq 'Image') {
            $_.ImageFormat
          }
          else {
            $_.ContainerFormat
          }
        </ScriptBlock>
      </TableColumnItem>


      <!-- Details -->
      <TableColumnItem>
         <ScriptBlock>
    $parts = @()

    if ($_.PSObject.TypeNames -contains 'GetMediaInfo.VideoMediaInfoResult') {
      if ($_.Resolution) {
        $parts += $_.Resolution
      }

      if ($null -ne $_.FrameRate) {
        $parts += ('{0:0.###} fps' -f $_.FrameRate)
      }
    }
    elseif ($_.PSObject.TypeNames -contains 'GetMediaInfo.AudioMediaInfoResult') {
      if ($_.Artist) {
        $parts += $_.Artist
      }

      if ($_.Album) {
        $parts += $_.Album
      }

      if ($null -ne $_.TrackNumber) {
        if ($null -ne $_.TrackCount) {
          $parts += ('Track {0}/{1}' -f $_.TrackNumber, $_.TrackCount)
        }
        else {
          $parts += ('Track {0}' -f $_.TrackNumber)
        }
      }
    }
    elseif ($_.PSObject.TypeNames -contains 'GetMediaInfo.ImageMediaInfoResult') {
      if ($_.Resolution) {
        $parts += $_.Resolution
      }

      if ($null -ne $_.BitDepth) {
        $parts += ('{0}-bit' -f $_.BitDepth)
      }
    }

    $parts -join ', '
  </ScriptBlock>
      </TableColumnItem>


      <!-- Duration -->
      <TableColumnItem>
        <ScriptBlock>
          if ($null -ne $_.Duration) {
            $_.Duration.ToString('hh\:mm\:ss\.fff')
          }
        </ScriptBlock>
      </TableColumnItem>


      <!-- Codec -->
      <TableColumnItem>
         <ScriptBlock>
    if ($_.PSObject.TypeNames -contains 'GetMediaInfo.VideoMediaInfoResult') {
      $_.VideoCodec
    }
    elseif ($_.PSObject.TypeNames -contains 'GetMediaInfo.AudioMediaInfoResult') {
      $_.AudioCodec
    }
  </ScriptBlock>
      </TableColumnItem>


      <!-- SizeMiB -->
      <TableColumnItem>
        <ScriptBlock>
          if ($null -ne $_.SizeMiB) {
            '{0:F3}' -f $_.SizeMiB
          }
        </ScriptBlock>
      </TableColumnItem>

    </TableColumnItems>
  </TableRowEntry>

</TableRowEntries>
  </TableControl>
</View>




    <View>
      <Name>GetMediaInfo.VideoMediaInfoResult.Table</Name>
      
      <ViewSelectedBy>
        <TypeName>GetMediaInfo.VideoMediaInfoResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Frame rate</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resolution</Label></TableColumnHeader>
          <TableColumnHeader><Label>Duration</Label></TableColumnHeader>
          <TableColumnHeader><Label>VideoCodec</Label></TableColumnHeader>
          <TableColumnHeader><Label>Audio</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.FrameRate) {
                    '{0:0.###} fps' -f $_.FrameRate
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>Resolution</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.Duration) {
                    $_.Duration.ToString('hh\:mm\:ss\.fff')
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>VideoCodec</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AudioCodec</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>GetMediaInfo.AudioMediaInfoResult.Table</Name>
      <ViewSelectedBy>
        <TypeName>GetMediaInfo.AudioMediaInfoResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Format</Label></TableColumnHeader>
          <TableColumnHeader><Label>Duration</Label></TableColumnHeader>
          <TableColumnHeader><Label>AudioBitRate</Label></TableColumnHeader>
          <TableColumnHeader><Label>SamplingRate</Label></TableColumnHeader>
          <TableColumnHeader><Label>Artist</Label></TableColumnHeader>
          <TableColumnHeader><Label>Album</Label></TableColumnHeader>
          <TableColumnHeader><Label>Track</Label></TableColumnHeader>

        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ContainerFormat</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.Duration) {
                    $_.Duration.ToString('hh\:mm\:ss\.fff')
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>AudioBitRate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SamplingRate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Artist</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Album</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -ne $_.TrackNumber) {
                    if ($null -ne $_.TrackCount) {
                      '{0}/{1}' -f $_.TrackNumber, $_.TrackCount
                    } else {
                      $_.TrackNumber
                    }
                  }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

